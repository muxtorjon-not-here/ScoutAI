# You normally don't edit this by hand: run.bat creates .env for you (see README.md).
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash
TG_BOT_TOKEN=your_bot_token
ADMIN_USER_ID=your_numeric_telegram_user_id
# gsk_... -> Groq (llama-3.3-70b-versatile); anything else -> Gemini
AI_API_KEY=your_gemini_or_groq_key
# Optional: comma-separated public channel usernames to watch from the first run
INITIAL_CHANNELS=
# Optional: set a password to open the dashboard from your phone (same Wi-Fi). Empty = this computer only.
WEB_PASSWORD=
